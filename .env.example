# PostgreSQL with pgvector extension
# e.g. postgresql://user:password@localhost:5432/rag
DATABASE_URL=

# Voyage AI — code-optimised embeddings (https://www.voyageai.com)
VOYAGE_API_KEY=

# Anthropic — optional, only required for scripts/ask.py (https://console.anthropic.com)
# ANTHROPIC_API_KEY=

# GitHub — optional; raises API rate limit from 60 to 5000 req/hr; required for private repos
# GITHUB_TOKEN=

# ── MCP HTTP authentication (required when running --transport http) ───────────
# In HTTP mode this server is its own OAuth authorization server: MCP clients
# (Claude Code, the claude.ai connector) register with it via Dynamic Client
# Registration, and it brokers sign-in with Google behind the scenes. Clients
# need only the server URL — no Google client id/secret of their own.
#
# This server's externally reachable base URL (no path, no trailing slash).
# Required whenever GOOGLE_ALLOWED_DOMAIN/GOOGLE_ALLOWED_EMAILS is set.
# MCP_PUBLIC_URL=https://your-app.up.railway.app

# The server-side Google OAuth "Web application" client used to broker sign-in.
# Create one in Google Cloud Console (APIs & Services → Credentials) and add
# <MCP_PUBLIC_URL>/auth/google/callback as an Authorised redirect URI. The
# secret is confidential — set it in the deploy environment, never commit it.
# GOOGLE_OAUTH_CLIENT_ID=123-abc.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: override the OAuth callback path (must match the redirect URI you
# register with Google). Defaults to /auth/google/callback.
# MCP_OAUTH_CALLBACK_PATH=/auth/google/callback

# Restrict access to a Google Workspace domain (e.g. "bes.au")
GOOGLE_ALLOWED_DOMAIN=

# Or restrict to specific emails (comma-separated)
# GOOGLE_ALLOWED_EMAILS=alice@example.com,bob@example.com

# ── After setting the above, index a repository: ──────────────────────────────
#   uv run python scripts/ingest.py --repo https://github.com/beyondessential/tupaia --namespace tupaia
# Or use an existing local checkout:
#   uv run python scripts/ingest.py /path/to/tupaia --namespace tupaia
